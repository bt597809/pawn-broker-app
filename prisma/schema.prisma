generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("CASHIER")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  loansCreated     Loan[]       @relation("LoanCreatedBy")
  paymentsDone     Payment[]    @relation("PaymentPerformedBy")
  noticesDone      LoanNotice[] @relation("NoticePerformedBy")
  auctionsDone     Auction[]    @relation("AuctionPerformedBy")
  ledgerEntries    LedgerEntry[] @relation("LedgerPerformedBy")
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String?
  address     String?
  idProofType String?
  idProofNo   String?
  createdAt   DateTime @default(now())
  loans       Loan[]
}

model Scheme {
  id                   Int      @id @default(autoincrement())
  name                 String   @unique
  interestRateMonthly  Float
  tenureDays           Int
  maxLtvPercent        Float    @default(75)
  precloseAllowed      Boolean  @default(true)
  createdAt            DateTime @default(now())
  loans                Loan[]
}

model Account {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  name          String
  accountType   String
  ledgerEntries LedgerEntry[]
}

model Loan {
  id                  Int          @id @default(autoincrement())
  voucherNo           String       @unique
  customerId          Int?
  customerName        String
  schemeId            Int?
  loanDate            DateTime
  dueDate             DateTime?
  loanAmountPaise     Int
  interestRateMonthly Float
  metalType           String       @default("GOLD")
  purityKarat         Float        @default(22)
  goldRatePaise       Int          @default(0)
  maxEligiblePaise    Int          @default(0)
  pledgedItemName     String
  grossWeightGm       Float
  stoneWeightGm       Float
  netWeightGm         Float
  estimatedValuePaise Int
  paymentMode         String
  comments            String?
  createdByUserId     Int?
  status              String       @default("ACTIVE")
  closedAt            DateTime?
  createdAt           DateTime     @default(now())
  customer            Customer?    @relation(fields: [customerId], references: [id])
  scheme              Scheme?      @relation(fields: [schemeId], references: [id])
  createdBy           User?        @relation("LoanCreatedBy", fields: [createdByUserId], references: [id])
  payments            Payment[]
  notices             LoanNotice[]
  auctions            Auction[]
}

model Payment {
  id                    Int      @id @default(autoincrement())
  loanId                Int
  voucherNo             String   @unique
  paymentDate           DateTime
  amountPaise           Int
  interestPortionPaise  Int
  principalPortionPaise Int
  comments              String?
  txnType               String   @default("PAYMENT")
  performedByUserId     Int?
  createdAt             DateTime @default(now())
  loan                  Loan     @relation(fields: [loanId], references: [id])
  performedBy           User?    @relation("PaymentPerformedBy", fields: [performedByUserId], references: [id])
}

model LoanNotice {
  id                Int      @id @default(autoincrement())
  loanId            Int
  noticeDate        DateTime
  channel           String
  notes             String?
  performedByUserId Int?
  createdAt         DateTime @default(now())
  loan              Loan     @relation(fields: [loanId], references: [id])
  performedBy       User?    @relation("NoticePerformedBy", fields: [performedByUserId], references: [id])
}

model Auction {
  id                Int      @id @default(autoincrement())
  loanId            Int
  voucherNo         String   @unique
  auctionDate       DateTime
  saleAmountPaise   Int
  expensesPaise     Int      @default(0)
  surplusPaise      Int      @default(0)
  shortfallPaise    Int      @default(0)
  paymentMode       String
  comments          String?
  performedByUserId Int?
  createdAt         DateTime @default(now())
  loan              Loan     @relation(fields: [loanId], references: [id])
  performedBy       User?    @relation("AuctionPerformedBy", fields: [performedByUserId], references: [id])
}

model LedgerEntry {
  id                Int      @id @default(autoincrement())
  voucherNo         String
  entryDate         DateTime
  accountId         Int
  debitPaise        Int      @default(0)
  creditPaise       Int      @default(0)
  referenceType     String
  referenceId       Int
  staffName         String?
  narration         String?
  performedByUserId Int?
  createdAt         DateTime @default(now())
  account           Account  @relation(fields: [accountId], references: [id])
  performedBy       User?    @relation("LedgerPerformedBy", fields: [performedByUserId], references: [id])

  @@index([entryDate])
  @@index([voucherNo])
}
